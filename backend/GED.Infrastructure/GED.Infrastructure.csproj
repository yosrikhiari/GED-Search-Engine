<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Configuration -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />

    <!-- FIX #1: PostgreSQL + EF Core (Npgsql provider) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.0" />

    <!-- FIX #3: Word/DOCX & Excel/XLSX extraction (already referenced, now actually used) -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />

    <!-- Search -->
    <PackageReference Include="OpenSearch.Client" Version="1.8.0" />

    <!-- Messaging (FIX #2: OCR worker uses this) -->
    <PackageReference Include="RabbitMQ.Client" Version="6.8.1" />

    <!-- OCR & PDF -->
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="itext7" Version="8.0.3" />

    <!-- Image processing -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- Utilities -->
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GED.Core\GED.Core.csproj" />
  </ItemGroup>

</Project>
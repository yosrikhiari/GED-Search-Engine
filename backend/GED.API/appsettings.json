{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GED": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": "${CORS_ORIGINS}"
  },
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}"
  },
  "OpenSearch": {
    "Url": "${OPENSEARCH_URL}",
    "DefaultIndex": "ged-documents",
    "Username": "${OPENSEARCH_USERNAME}",
    "Password": "${OPENSEARCH_PASSWORD}",
    "SecurityEnabled": "${OPENSEARCH_SECURITY_ENABLED}"
  },
  "RabbitMQ": {
    "Host": "${RABBITMQ_HOST}",
    "Port": "${RABBITMQ_PORT}",
    "Username": "${RABBITMQ_USER}",
    "Password": "${RABBITMQ_PASSWORD}",
    "VirtualHost": "${RABBITMQ_VHOST}"
  },
  "OCR": {
    "OcrmypdfPath": "ocrmypdf",
    "TesseractPath": "tesseract",
    "DateConfidenceThreshold": 0.7
  },
  "Storage": {
    "Type": "Local",
    "Local": {
      "BasePath": "/var/lib/ged/documents"
    }
  },
  "NLP": {
    "Enabled": true,
    "LlmApiEndpoint": "http://localhost:11434/api/generate",
    "EmbedApiEndpoint": "http://localhost:11434/api/embed",
    "Model": "mistral",
    "EmbedModel": "bge-m3"
  },
  "Tika": {
    "Enabled": true,
    "Url": "http://localhost:9998"
  },
  "Search": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "EnableHighlighting": true,
    "HighlightFragmentSize": 150,
    "MaxHighlightFragments": 3,
    "Bm25Weight": 0.6,
    "SemanticWeight": 0.4,
    "SemanticThreshold": 0.30,
    "ChunkSemanticThreshold": 0.20,
    "ChunkHybridBm25Weight": 0.4,
    "ChunkHybridSemanticWeight": 0.6,
    "ChunkRerankFusionK": 60
  },
  "Document": {
    "MaxUploadSizeMB": 100,
    "AllowedFileTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "image/jpeg",
      "image/png",
      "image/tiff",
      "image/bmp",
      "image/webp",
      "text/plain"
    ]
  },
  "Redis": {
    "Enabled": "${REDIS_ENABLED}",
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "SearchCacheTtlSeconds": 120
  },
  "Reindex": {
    "Enabled": true,
    "BatchSize": 50,
    "StaleCheckIntervalMinutes": 5,
    "MissingCheckIntervalMinutes": 15,
    "FailedRetryIntervalMinutes": 30
  },
  "Auth": {
    "UsersFilePath": "/var/lib/ged/users.json",
    "SessionDurationHours": 8
  },
  "RAG": {
    "TopK": 5,
    "MaxContextChars": 6000,
    "ChunkSize": 2000,
    "ChunkOverlap": 500,
    "MinChunkLen": 100,
    "ConfidenceThreshold": 0.45,
    "EnableBm25Fallback": true,
    "RetrievalTimeoutSeconds": 30,
    "EnableReranking": true,
    "RerankerSemanticWeight": 0.6,
    "RerankerLexicalWeight": 0.4,
    "RerankerMinKeywordOverlap": 1,
    "EnableQueryClassification": true,
    "QueryClassification": {
      "FallbackToFactual": true,
      "LowConfidenceThreshold": 0.6,
      "ComparisonMaxChunksPerDoc": 2,
      "TypeConfigs": {
        "factual": { "topK": 5, "confidenceThreshold": 0.5 },
        "summarization": { "topK": 10, "confidenceThreshold": 0.3 },
        "comparison": { "topK": 8, "confidenceThreshold": 0.35 },
        "extraction": { "topK": 5, "confidenceThreshold": 0.4 }
      }
    }
  },
  "Monitoring": {
    "Prometheus": {
      "Enabled": true,
      "Port": 9090
    },
    "HealthCheck": {
      "Enabled": true,
      "Endpoint": "/health"
    }
  },
  "ResourceSaver": {
    "Enabled": false
  }
}

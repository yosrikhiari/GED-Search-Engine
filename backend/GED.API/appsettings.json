{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GED": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ged_db;Username=ged_user;Password=ged_pass;Port=5432"
  },
  "OpenSearch": {
    "Url": "http://localhost:9200",
    "DefaultIndex": "ged-documents",
    "Username": "",
    "Password": ""
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123",
    "VirtualHost": "/"
  },
  "OCR": {
    "TessDataPath": "/usr/share/tesseract-ocr/5/tessdata",
    "DefaultLanguage": "eng",
    "SupportedLanguages": ["eng", "fra", "spa", "deu"],
    "MaxConcurrentJobs": 5
  },
  "Storage": {
    "Type": "Local",
    "Local": {
      "BasePath": "/var/lib/ged/documents"
    }
  },
  "NLP": {
    "Enabled": true,
    "LlmApiEndpoint": "http://localhost:11434/api/generate",
    "Model": "llama3.2"
  },
  "Search": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "EnableHighlighting": true,
    "HighlightFragmentSize": 150,
    "MaxHighlightFragments": 3
  },
  "Document": {
    "MaxUploadSizeMB": 100,
    "AllowedFileTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "image/jpeg",
      "image/png",
      "image/tiff",
      "text/plain"
    ]
  },

  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "SearchCacheTtlSeconds": 120
  },

  "Embeddings": {
    "Enabled": false,
    "Model": "nomic-embed-text",
    "Dimensions": 768
  },

  "Reindex": {
    "Enabled": true,
    "BatchSize": 50,
    "StaleCheckIntervalMinutes": 5,
    "MissingCheckIntervalMinutes": 15,
    "FailedRetryIntervalMinutes": 30
  },

  "Monitoring": {
    "Prometheus": {
      "Enabled": true,
      "Port": 9090
    },
    "HealthCheck": {
      "Enabled": true,
      "Endpoint": "/health"
    }
  }
}
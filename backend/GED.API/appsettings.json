{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GED": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ged_db;Username=ged_user;Password=ged_pass;Port=5432"
  },
  "OpenSearch": {
    "Url": "http://localhost:9200",
    "DefaultIndex": "ged-documents",
    "Username": "",
    "Password": ""
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "admin123",
    "VirtualHost": "/"
  },
  "OCR": {
    "TessDataPath": "/usr/share/tesseract-ocr/4.00/tessdata",
    "DefaultLanguage": "eng",
    "SupportedLanguages": ["eng", "fra", "spa", "deu"],
    "MaxConcurrentJobs": 5
  },
  "Storage": {
    "Type": "Swift",
    "Swift": {
      "AuthUrl": "http://keystone:5000/v3",
      "Container": "ged-documents",
      "Username": "your-username",
      "Password": "your-password",
      "ProjectName": "your-project",
      "Region": "RegionOne",
      "TempUrlKey": "your-temp-url-key"
    },
    "Local": {
      "BasePath": "/var/lib/ged/documents"
    }
  },
  "NLP": {
     "Enabled": true,
     "LlmApiEndpoint": "http://localhost:11434/api/generate",
     "Model": "llama3.2"
   },
  "Search": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "EnableHighlighting": true,
    "HighlightFragmentSize": 150,
    "MaxHighlightFragments": 3
  },
  "Document": {
    "MaxUploadSizeMB": 100,
    "AllowedFileTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "image/jpeg",
      "image/png",
      "image/tiff",
      "text/plain"
    ]
  },
  "Monitoring": {
    "Prometheus": {
      "Enabled": true,
      "Port": 9090
    },
    "HealthCheck": {
      "Enabled": true,
      "Endpoint": "/health"
    }
  }
}